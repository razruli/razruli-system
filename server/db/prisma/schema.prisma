// server/db/prisma/schema.prisma
// ============================================================================
// MAIN SCHEMA - Prisma v7 modular schema composition
// ============================================================================
// Single source of truth that imports modular model definitions
// Models are organized by domain in separate files for maintainability
// ============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// =============================================================================
// SHARED ENUMS (Used across all models)
// =============================================================================

enum VerificationStatus {
  pending
  verified
  rejected
  suspended
}

enum CarrierAuthorityType {
  common_carrier
  contract_carrier
  private_carrier
}

enum ShipmentStatus {
  draft
  posted
  bidding_open
  bids_received
  bid_selected
  assigned
  in_transit
  delivered
  completed
  cancelled
  disputed
}

enum FreightStatus {
  draft
  available
  claimed
  assigned
  completed
  archived
}

enum WarehouseNeedStatus {
  posted
  bidding_open
  bids_received
  warehouse_selected
  assigned
  in_storage
  completed
  cancelled
}

enum BidStatus {
  pending
  rule_compliant
  rule_non_compliant
  accepted
  rejected
  expired
}

enum RuleType {
  insurance_amount
  hos_clean
  vehicle_age
  hazmat_certified
  temperature_control
  early_confirm
  capacity_match
  access_hours
  location_proximity
}

enum TruckStatus {
  available
  in_maintenance
  in_transit
  out_of_service
}

enum DriverStatus {
  active
  inactive
  on_leave
  terminated
}