// server/db/prisma/models/objects/freight.prisma
// ============================================================================
// FREIGHT MODEL - Physical goods to be transported
// Phase 1: Owner creates, sets specs + budget
// ============================================================================

model Freight {
  id            String @id @default(cuid())
  freightNumber String @unique

  // Phase 1: Owner posts freight
  freightOwnerId String
  freightOwner   FreightOwner @relation(fields: [freightOwnerId], references: [id], onDelete: Cascade)

  // Phase 2: Single Broker Lock - one freight per broker
  brokerId String?
  broker   Broker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  // Core freight specs
  productName        String
  productDescription String?
  productType        String
  hsCode             String?

  unitType    String @default("pieces")
  quantity    Int
  unitWeight  Float
  totalWeight Float
  length      Float?
  width       Float?
  height      Float?
  volume      Float

  // Special handling
  isHazmat          Boolean @default(false)
  hazmatClass       String?
  hazmatUNNumber    String?
  hazmatDescription String?

  isFragile      Boolean @default(false)
  isPerishable   Boolean @default(false)
  temperatureMin Float?
  temperatureMax Float?

  isValueable   Boolean @default(false)
  declaredValue BigInt?

  requiresHandling String[]

  // Warehouse assignment
  currentWarehouseId String?
  currentWarehouse   Warehouse? @relation(fields: [currentWarehouseId], references: [id])
  storageStartDate   DateTime?
  storageEndDate     DateTime?

  // FSM: DRAFT → AVAILABLE → CLAIMED → ASSIGNED → COMPLETED
  status FreightStatus @default(draft)

  // Audit trail
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shipments ShipmentFreight[]

  // Indexes for query performance
  @@index([freightOwnerId, status])
  @@index([brokerId, status])
  @@index([createdAt, status])
}
