// server/db/prisma/models/objects/shipment.prisma
// ============================================================================
// SHIPMENT MODEL - Main orchestrator coordinating freight movement
// Phases 2-11: Broker creates, opens bidding, selects carrier/warehouse, executes
// ============================================================================

model Shipment {
  id             String @id @default(cuid())
  shipmentNumber String @unique

  // Phase 1-2: Parties involved
  freightOwnerId String
  freightOwner   FreightOwner @relation(fields: [freightOwnerId], references: [id], onDelete: Cascade)

  brokerId String
  broker   Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  // Phase 5-6: Carrier selected via bidding
  carrierId String?
  carrier   Carrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  // Proof of delivery
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  truckId String?
  truck   Truck?  @relation(fields: [truckId], references: [id], onDelete: SetNull)

  // Warehouse routing (Phase 8-9: selected via warehouse bidding)
  originWarehouseId String
  originWarehouse   Warehouse @relation("OriginWarehouse", fields: [originWarehouseId], references: [id], onDelete: Restrict)

  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("DestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: SetNull)

  // Timeline
  pickupScheduled   DateTime
  pickupActual      DateTime?
  deliveryScheduled DateTime
  deliveryActual    DateTime?

  // Phase 3: Upfront Margin Agreement (Rule #3)
  ownerBudget         BigInt? // Original owner budget
  brokerMarginPercent Float   @default(0.10) // E.g., 0.10 = 10%
  brokerMarginAmount  BigInt? // Calculated & locked after margin agreed

  // Phase 5: Bidding deadline (Rule #5)
  biddingOpenedAt  DateTime?
  biddingOpenUntil DateTime?

  // Phase 6: Selected bid tracking
  acceptedBidId String?

  // FSM: DRAFT → POSTED → BIDDING_OPEN → BIDS_RECEIVED → BID_SELECTED → ASSIGNED → IN_TRANSIT → DELIVERED → COMPLETED
  status ShipmentStatus @default(draft)

  // Pricing (breakdown for transparency)
  baseRate            BigInt?
  surchargeRate       BigInt  @default(0)
  fuelSurcharge       Float   @default(0.0)
  fuelSurchargeAmount BigInt  @default(0)
  marketAdjustment    BigInt  @default(0)

  customerRate BigInt?
  carrierRate  BigInt?

  estimatedRevenue BigInt?
  estimatedCost    BigInt?
  estimatedMargin  BigInt?

  actualRevenue BigInt?
  actualCost    BigInt?
  actualMargin  BigInt?

  // Route details
  distance    Float?
  estimatedOD Float?
  actualOD    Float?

  // Documentation
  poNumber            String?
  referenceNumbers    String[]
  specialInstructions String?

  // Audit trail
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  // Relations
  freights        ShipmentFreight[]
  stops           ShipmentStop[]
  logs            ShipmentLog[]
  events          ShipmentEvent[]
  documents       ShipmentDocument[]
  bidRules        BidRule[]
  bids            ShipmentBid[]
  warehouseNeeds  WarehouseNeed[]
  cancellationFee CancellationFee?

  // Indexes for query performance
  @@index([brokerId, status])
  @@index([carrierId, status])
  @@index([freightOwnerId, status])
  @@index([createdAt, status])
  @@index([biddingOpenUntil, status])
}
