// ============================================================================
// OPERATIONS DOMAIN - Processes & Workload Management
// ============================================================================
// Defines business processes with resource consumption parameters
// L = (T_hours / 8) * (1 + K_burn + K_crit + K_new) * K_diff
// ============================================================================

/// Business process with human-readable complexity classification
/// Complexity converted to k-factors internally for CU calculation
/// Weight formula: (plannedHours/8) × (1 + kBurn + kCrit + kNew)
model Process {
  id                String       @id @default(cuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId      String
  department        Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Process Metadata
  title             String       @db.VarChar(255)
  description       String?      @db.Text

  // Time Estimate (user provides this in hours)
  plannedHours      Int

  // HUMAN-READABLE COMPLEXITY FACTORS (replaces kBurn, kCrit, kNew)
  // These get converted to k-values internally
  
  /// Difficulty/Skill Required: routine|standard|complex|expert
  /// routine = Junior can do, standard = Mid-level, complex = Senior, expert = Lead+
  complexity        String       @default("standard") @db.VarChar(50)

  /// Business/Customer Impact: low|medium|high|critical
  /// low = nice to have, medium = normal work, high = important, critical = system down
  businessImpact    String       @default("medium") @db.VarChar(50)

  /// Is this new/unfamiliar work? routine|familiar|new|experimental
  /// routine = done before, familiar = similar tech, new = new framework, experimental = cutting edge
  newness           String       @default("routine") @db.VarChar(50)

  /// Does team get burned out by this type of work? false|true
  /// true = mentally exhausting, requires breaks, increases burnout risk
  isBurningOut      Boolean      @default(false)

  // Calculated Process Weight (stored at import time, can be recalculated)
  weight            Float?       @db.DoublePrecision

  // Target Skill Level for Execution
  targetGradeId     Int
  targetGrade       Grade        @relation(fields: [targetGradeId], references: [id])

  // Status Tracking
  status            String       @default("open") @db.VarChar(50)

  // Relations
  taskAssignments   TaskAssignment[]
  finishedTasks     FinishedTask[]

  createdAt         DateTime     @default(now()) @db.Timestamp(3)
  updatedAt         DateTime     @updatedAt @db.Timestamp(3)

  @@index([companyId])
  @@index([departmentId])
  @@index([targetGradeId])
  @@index([status])
  @@map("process")
}
