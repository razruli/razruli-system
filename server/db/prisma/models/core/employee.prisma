// ============================================================================
// CORE DOMAIN - Employees & Capacity Management
// ============================================================================
// Manages employee master data and capacity coefficients
// P_day = 1.0 * K_grade * K_gen * K_age * K_tenure * K_efficiency
// ============================================================================

/// Employment contract types
enum EmploymentType {
  LABOR_CONTRACT    /// Full-time labor contract (трудовой договор / ТД)
  SERVICE_CONTRACT  /// Gig work contract (гражданско-правовой / ГПХ)
  SELF_EMPLOYED     /// Self-employed / contractor (самозанятый)
}

/// Employee gender
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Employee work status
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

/// Employee with capacity coefficients and employment details
model Employee {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId      String
  department        Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Identity & Demographics (English-first)
  firstName         String           @db.VarChar(255)
  lastName          String           @db.VarChar(255)
  gradeId           Int
  grade             Grade            @relation(fields: [gradeId], references: [id])

  gender            Gender           @default(OTHER)
  birthDate         DateTime?        @db.Timestamp(3)

  // Employment Dates
  hireDate          DateTime         @db.Timestamp(3)
  fireDate          DateTime?        @db.Timestamp(3)

  // Capacity Coefficients
  // kEfficiency: optional override for special cases (e.g., senior devs, experts)
  // When null/not set, defaults to 1.0 during capacity calculation
  // Other factors (age, gender, tenure) are calculated from employee data
  kEfficiency       Float?           @db.DoublePrecision
  workingHoursPerDay Int             @default(8)

  // Calculated Capacity (stored at import time, can be recalculated)
  monthlyCU         Float?           @db.DoublePrecision @default(0.0)

  // Employment Classification
  employmentType    EmploymentType   @default(LABOR_CONTRACT)
  status            EmployeeStatus   @default(ACTIVE)

  // Relations
  managedDepartment Department?      @relation("DepartmentHead")
  taskAssignments   TaskAssignment[]
  loadSnapshots     LoadSnapshot[]
  finishedTasks     FinishedTask[]
  history           EmployeeHistory[] @relation("EmployeeToHistory")

  // Metadata
  metadata          Json             @default("{}") @db.JsonB

  createdAt         DateTime         @default(now()) @db.Timestamp(3)
  updatedAt         DateTime         @updatedAt @db.Timestamp(3)

  @@unique([companyId, firstName, lastName])
  @@index([companyId])
  @@index([departmentId])
  @@index([gradeId])
  @@index([status])
  @@map("employee")
}
