// server/db/prisma/models/supporting/penalties.prisma
// ============================================================================
// PENALTY MODELS - Cancellation fees and compliance tracking
// Rule #7: Cancellation Penalties (Protect Bidders)
// ============================================================================

model CancellationFee {
  id String @id @default(cuid())

  // Can be for shipment OR warehouse need
  shipmentId String?   @unique
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  warehouseNeedId String?        @unique
  warehouseNeed   WarehouseNeed? @relation(fields: [warehouseNeedId], references: [id], onDelete: Cascade)

  // Penalty calculation
  originalValue  BigInt // Shipment value or Warehouse need value
  feePercentage  Float // 5% (0.05) or 10% (0.10)
  totalFeeAmount BigInt // originalValue * feePercentage

  // Who triggered cancellation
  cancelledBy       String // "owner" | "broker" | "carrier" | "warehouse"
  cancelledByUserId String?

  // Distribution tracking
  bidderIds     String[] // List of bidder IDs who bid (to split fee)
  paidBidderIds String[] // List of bidder IDs already paid

  // Calculation & distribution timing
  calculatedAt  DateTime  @default(now())
  distributedAt DateTime?

  // Status
  status String @default("pending") // pending | distributed | archived

  // Audit trail
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  penaltyPayments PenaltyPayment[]

  @@index([shipmentId])
  @@index([warehouseNeedId])
  @@index([status])
  @@index([distributedAt])
}

model PenaltyPayment {
  id                String          @id @default(cuid())
  cancellationFeeId String
  cancellationFee   CancellationFee @relation(fields: [cancellationFeeId], references: [id], onDelete: Cascade)

  // Recipient (carrier or warehouse)
  recipientId   String // Carrier ID or Warehouse ID
  recipientType String // "carrier" | "warehouse"

  // Payment details
  amountPaid    BigInt
  paymentStatus String @default("pending") // pending | completed | failed

  // Audit trail
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([cancellationFeeId, recipientId])
  @@index([recipientId, paymentStatus])
  @@index([paidAt])
}
