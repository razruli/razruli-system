// server/db/prisma/models/supporting/contracts-and-rates.prisma
// ============================================================================
// CONTRACTS & RATES MODELS - Pricing agreements and rate negotiations
// ============================================================================

model BrokerCarrierContract {
  id       String @id @default(cuid())
  brokerId String
  broker   Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  contractNumber String @unique

  status    String    @default("active")
  startDate DateTime
  endDate   DateTime?

  defaultRate BigInt
  minRate     BigInt
  maxRate     BigInt

  volumeDiscount  Float @default(0.0)
  volumeThreshold Int?

  termsDays    Int    @default(30)
  paymentTerms String @default("Net30")

  baselineFuel         Float  @default(3.0)
  fuelSurchargeFormula String @default("(current_price - baseline) * 0.90")

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rates BrokerRate[]

  @@unique([brokerId, carrierId])
}

model BrokerRate {
  id         String                @id @default(cuid())
  contractId String
  contract   BrokerCarrierContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  brokerRateId String

  originState String?
  destState   String?
  originCity  String?
  destCity    String?

  laneDescription String?

  rate          BigInt
  minimumCharge BigInt

  effectiveDate DateTime
  expiryDate    DateTime?

  freightClassMin Int?
  freightClassMax Int?
  weightMin       Float?
  weightMax       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, brokerRateId])
}

model CarrierRate {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  carrierRateId String @unique

  originState String?
  destState   String?
  originCity  String?
  destCity    String?

  laneDescription String?

  baseRate BigInt
  minRate  BigInt
  maxRate  BigInt

  costPerMile  Float?
  deadheadCost BigInt?

  effectiveDate DateTime
  expiryDate    DateTime?

  freightClassMin Int?
  freightClassMax Int?
  weightMin       Float?
  weightMax       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarrierAccessorial {
  id        String  @id @default(cuid())
  carrierId String
  carrier   Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  serviceCode        String
  serviceName        String
  serviceDescription String?

  unitType String @default("flat")
  unitRate BigInt

  availableRegions String[]
  minRate          BigInt   @default(0)
  maxRate          BigInt   @default(0)

  isApproved Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([carrierId, serviceCode])
}
