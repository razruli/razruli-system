// server/db/prisma/models/parties/freight-owner.prisma
// ============================================================================
// FREIGHT OWNER MODEL - Company/Individual with goods to ship
// ============================================================================

model FreightOwner {
  id          String @id @default(cuid())
  companyName String @unique
  email       String @unique
  phone       String
  address     String
  city        String
  state       String
  zipCode     String
  country     String @default("US")

  contactPersonName String
  contactPhone      String

  taxId        String? @unique
  businessType String

  hazmatApproved        Boolean @default(false)
  internationalShipping Boolean @default(false)

  rating         Float @default(5.0)
  reviewCount    Int   @default(0)
  totalShipments Int   @default(0)

  preferredPaymentMethod String?

  isActive           Boolean            @default(true)
  verificationStatus VerificationStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shipments Shipment[]
  freights  Freight[]
}
