// ============================================================================
// AUDIT DOMAIN - Employee History & Change Tracking
// ============================================================================
// Maintains complete change history for compliance and analysis
// ============================================================================

/// Historical record of employee attribute changes
model EmployeeHistory {
  id                String       @id @default(cuid())
  employeeId        String
  employee          Employee     @relation("EmployeeToHistory", fields: [employeeId], references: [id], onDelete: Cascade)

  // Change Metadata
  fieldName         String       @db.VarChar(100)
  oldValue          String?      @db.Text
  newValue          String?      @db.Text

  // Audit Trail
  changedById       String?
  changedBy         Actor?       @relation("CreatedByActor", fields: [changedById], references: [id], onDelete: SetNull)
  
  approvedById      String?
  approvedBy        Actor?       @relation("ApprovedByActor", fields: [approvedById], references: [id], onDelete: SetNull)
  
  changedAt         DateTime     @default(now()) @db.Timestamp(3)
  reason            String?      @db.Text

  @@index([employeeId])
  @@index([changedAt])
  @@index([fieldName])
  @@index([changedById])
  @@index([approvedById])
  @@map("employee_history")
}

/// Comprehensive audit log for all entity changes
model AuditLog {
  id                String       @id @default(cuid())
  companyId         String

  // Entity Tracked
  entityType        String       @db.VarChar(100)
  entityId          String

  // Change Details
  action            String       @db.VarChar(50)
  oldValues         Json?        @db.JsonB
  newValues         Json?        @db.JsonB

  // Audit Trail
  createdById       String
  createdBy         Actor        @relation("CreatedByActor", fields: [createdById], references: [id], onDelete: Restrict)
  
  changedAt         DateTime     @default(now()) @db.Timestamp(3)

  @@index([companyId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([changedAt])
  @@index([createdById])
  @@map("audit_log")
}
