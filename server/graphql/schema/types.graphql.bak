# General GraphQL Types (Shared Across All Features)

# Date Range
input DateRangeInput {
  from: DateTime!
  to: DateTime!
}

type DateRange {
  from: DateTime!
  to: DateTime!
}

# Pagination
type PageInfo {
  total: Int!
  hasMore: Boolean!
  offset: Int!
  limit: Int!
}

input PaginationInput {
  offset: Int
  limit: Int
}

# Error Handling
type Error {
  code: String!
  message: String!
  extensions: JSON
}

interface Node {
  id: ID!
}

#Status Types
enum SortOrder {
  ASC
  DESC
}
