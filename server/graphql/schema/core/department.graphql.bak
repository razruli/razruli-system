"""
Department type and resolvers
Organizational unit with optional head reference
"""
type Department {
  """
  Unique identifier
  """
  id: String!

  """
  Company this department belongs to
  """
  companyId: String!
  company: Company! # Field resolver
  """
  Department name
  """
  name: String!

  """
  Department head (optional)
  """
  headId: String
  head: Employee # Field resolver
  """
  All employees in this department
  """
  employees: [Employee!]! # Field resolver
  """
  All processes assigned to department
  """
  processes: [Process!]! # Field resolver
  """
  All tasks in department
  """
  taskAssignments: [TaskAssignment!]! # Field resolver
  """
  Load snapshots for this department
  """
  loadSnapshots: [LoadSnapshot!]! # Field resolver
  """
  Created at
  """
  createdAt: DateTime!

  """
  Updated at
  """
  updatedAt: DateTime!
}

"""
Input for creating a department
"""
input CreateDepartmentInput {
  companyId: String!
  name: String!
  headId: String
}

"""
Input for updating a department
"""
input UpdateDepartmentInput {
  name: String
  headId: String
}

"""
Filter options for departments
"""
input DepartmentFilterInput {
  companyId: String!
  search: String # Search in department name
}

"""
Response with department list
"""
type DepartmentListResponse {
  items: [Department!]!
  total: Int!
}

extend type Query {
  """
  Get department by ID
  """
  department(id: String!): Department

  """
  Get all departments for company
  """
  departments(filter: DepartmentFilterInput!): DepartmentListResponse!

  """
  Get department with all employees and load metrics
  """
  departmentWithMetrics(
    id: String!
    periodStart: DateTime
    periodEnd: DateTime
  ): DepartmentMetrics
}

"""
Extended department with metrics
"""
type DepartmentMetrics {
  department: Department!
  totalEmployees: Int!
  activeEmployees: Int!
  overloadedCount: Int!
  totalCapacity: Float!
  totalLoad: Float!
  loadIndex: Float!
}

extend type Mutation {
  """
  Create new department
  """
  createDepartment(input: CreateDepartmentInput!): Department!

  """
  Update department
  """
  updateDepartment(id: String!, input: UpdateDepartmentInput!): Department!

  """
  Delete department
  """
  deleteDepartment(id: String!): Boolean!

  """
  Assign department head
  """
  assignDepartmentHead(departmentId: String!, employeeId: String!): Department!
}

extend type Subscription {
  """
  Subscribe to department changes
  """
  departmentUpdated(companyId: String!): Department!

  """
  Subscribe to new departments
  """
  departmentCreated(companyId: String!): Department!
}
