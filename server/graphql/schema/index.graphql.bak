# ============================================================================
# GraphQL Root Schema
# Defines Query, Mutation, Subscription roots
# All domain schemas extend these types
# ============================================================================

"""
Root Query type
Extended by each domain module (core, operations, analytics, audit)
"""
type Query {
  """
  Health check endpoint
  """
  health: String!
}

"""
Root Mutation type
Extended by each domain module
"""
type Mutation {
  """
  Placeholder - replaced by domain mutations
  """
  _placeholder: String
}

"""
Root Subscription type
Extended by each domain module
"""
type Subscription {
  """
  Placeholder - replaced by domain subscriptions
  """
  _placeholder: String
}

# ============================================================================
# DOMAIN SCHEMAS (Auto-imported by build process)
# ============================================================================

# 🏢 CORE DOMAIN - Company, Department, Employee, Grade
# Location: ./core/*.graphql
# - company.graphql
# - department.graphql
# - employee.graphql
# - grade.graphql

# 📋 OPERATIONS DOMAIN - Process, TaskAssignment
# Location: ./operations/*.graphql
# - process.graphql
# - taskAssignment.graphql

# 📊 ANALYTICS DOMAIN - LoadSnapshot, GapAnalysis
# Location: ./analytics/*.graphql
# - loadSnapshot.graphql
# - gapAnalysis.graphql

# 📝 AUDIT DOMAIN - EmployeeHistory, AuditLog
# Location: ./audit/*.graphql
# - employeeHistory.graphql
# - auditLog.graphql
